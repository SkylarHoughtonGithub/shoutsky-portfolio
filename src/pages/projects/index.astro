---
import { PROJECTS_CONFIG } from '~/config'
import Layout from '~/layouts/Layout.astro'
import SectionDivider from '~/components/base/SectionDivider.astro'
import { getAllProjects } from '~/lib/data'
import PageTitle from '~/components/base/PageTitle.astro'

const { title, description, introduce } = PROJECTS_CONFIG
const projects = await getAllProjects()

const statusLabel: Record<string, string> = {
  shipped: 'Shipped',
  'in-progress': 'In progress',
  paused: 'Paused',
  archived: 'Archived',
}
---

<Layout {title} {description}>
  <div class="relative z-[1] py-8 pb-10">
    <div class="px-6 sm:px-8">
      <PageTitle {title} {introduce} />
      <div class="filter-banner" data-filter-banner hidden role="status" aria-live="polite">
        <span class="filter-banner-label">Filtered by</span>
        <span class="filter-banner-tag" data-filter-tag></span>
        <span class="filter-banner-count" data-filter-count></span>
        <a href="/projects" class="filter-clear" aria-label="Clear filter">
          <span>Clear</span>
          <span aria-hidden="true">×</span>
        </a>
      </div>
    </div>
    <div class="grid grid-cols-1 fade-up">
      {
        projects.map((project, index) => (
          <div data-project-card data-tags={project.data.tags.join(',')}>
            <a
              href={`/projects/${project.id}`}
              class="project-card group relative block hover:bg-muted/30 dark:hover:bg-muted/30 px-6 sm:px-8 py-5"
            >
              <div class="flex items-start justify-between gap-4 mb-2">
                <h2 class="font-semibold text-xl tracking-tight group-hover:text-primary transition-colors">
                  {project.data.name}
                </h2>
                {project.data.status && (
                  <span class="shrink-0 inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md border border-tag-border bg-tag-bg text-tag-text text-[10px] font-medium uppercase tracking-wide">
                    {project.data.status === 'shipped' && <span class="size-1.5 rounded-full bg-[var(--term-ok)]" />}
                    {project.data.status === 'in-progress' && <span class="size-1.5 rounded-full bg-[var(--neon)] animate-pulse" />}
                    {project.data.status === 'paused' && <span class="size-1.5 rounded-full bg-[var(--muted)]" />}
                    {statusLabel[project.data.status]}
                  </span>
                )}
              </div>
              <p class="text-muted-foreground mb-3 text-pretty">{project.data.description}</p>
              {project.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5">
                  {project.data.tags.map((tag) => (
                    <span class="inline-flex items-center px-2 py-0.5 rounded-md border border-tag-border bg-tag-bg text-tag-text text-[10px] uppercase tracking-wide">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </a>
            <SectionDivider className={index == projects.length - 1 ? 'hidden' : ''} />
          </div>
        ))
      }
    </div>
  </div>
</Layout>

<script>
  const params = new URLSearchParams(window.location.search)
  const tag = params.get('tag')
  if (tag) {
    const banner = document.querySelector<HTMLElement>('[data-filter-banner]')
    const tagEl = document.querySelector<HTMLElement>('[data-filter-tag]')
    const countEl = document.querySelector<HTMLElement>('[data-filter-count]')
    const cards = document.querySelectorAll<HTMLElement>('[data-project-card]')
    const normalized = tag.trim().toLowerCase()

    let matches = 0
    cards.forEach((card) => {
      const cardTags = (card.dataset.tags ?? '').split(',').map((t) => t.trim().toLowerCase())
      const match = cardTags.includes(normalized)
      if (match) matches += 1
      const link = card.querySelector('.project-card')
      if (!match) link?.classList.add('filtered-out')
    })

    if (banner && tagEl) {
      tagEl.textContent = tag
      banner.hidden = false
      if (countEl) {
        countEl.textContent = `${matches} of ${cards.length} match`
      }
    }
  }
</script>
