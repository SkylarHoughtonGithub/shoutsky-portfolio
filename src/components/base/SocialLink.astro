---
import { cn } from '~/lib/utils'

interface Props extends Omit<astroHTML.JSX.AnchorHTMLAttributes, 'class' | 'children'> {
  icon: string
  class?: string | Record<string, boolean>
}

const { icon, class: className, ...props }: Props = Astro.props
---

<a
  class={cn(
    'group -m-1 p-1 ring-offset-background focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 rounded-lg flex items-center cursor-pointer',
    'transition-all duration-300 ease-out',
    className
  )}
  {...props}
  target="_blank"
>
  <span
    class={cn('h-6 w-6 text-muted-foreground transition-all duration-300 ease-out', 'group-hover:text-primary group-hover:rotate-6', icon)}
  ></span>
</a>
