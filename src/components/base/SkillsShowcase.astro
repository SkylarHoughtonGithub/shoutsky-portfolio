---
import { cn } from '~/lib/utils'
import type { SkillData, Skill } from '~/types'

interface Props {
  skillsData: SkillData[]
}

const { skillsData }: Props = Astro.props

const duplicateSkills = (skills: Skill[]) => [...skills, ...skills, ...skills, ...skills]
---

<div class="stack-marquee relative py-2 overflow-hidden">
  {
    skillsData.map((row: SkillData) => {
      const duplicatedSkills = duplicateSkills(row.skills)
      return (
        <div class="relative w-full overflow-hidden my-3 group content-visibility-auto">
          <div
            class={cn(
              'flex w-max will-change-transform',
              row.direction === 'right' ? 'animate-[scroll-reverse_32s_linear_infinite]' : 'animate-[scroll_32s_linear_infinite]',
              'group-hover:[animation-play-state:paused]',
              'group-focus-within:[animation-play-state:paused]'
            )}
            style="transform: translateZ(0);"
          >
            {duplicatedSkills.map((skill, idx) => (
              <a
                href={`/projects?tag=${encodeURIComponent(skill.name)}`}
                class="stack-pill"
                data-tag={skill.name}
                aria-label={`Filter projects by ${skill.name}`}
                tabindex={idx < row.skills.length ? 0 : -1}
                aria-hidden={idx >= row.skills.length}
              >
                <span class={cn('stack-pill-icon', skill.icon)} aria-hidden="true" />
                <span class="stack-pill-text">{skill.name}</span>
              </a>
            ))}
          </div>
        </div>
      )
    })
  }

  <div class="stack-fade stack-fade-left pointer-events-none" aria-hidden="true"></div>
  <div class="stack-fade stack-fade-right pointer-events-none" aria-hidden="true"></div>
</div>

<style is:global>
  @keyframes scroll {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-25%, 0, 0);
    }
  }

  @keyframes scroll-reverse {
    0% {
      transform: translate3d(-25%, 0, 0);
    }
    100% {
      transform: translate3d(0, 0, 0);
    }
  }

  .stack-marquee {
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 10%, #000 90%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, #000 10%, #000 90%, transparent 100%);
  }

  .stack-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0.4rem;
    padding: 0.45rem 0.95rem;
    border: 1px solid color-mix(in srgb, var(--neon) 22%, var(--line));
    border-radius: 0.5rem;
    background: color-mix(in srgb, var(--panel) 70%, var(--term-bg));
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--neon) 6%, transparent);
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .stack-pill:hover,
  .stack-pill:focus-visible {
    transform: translateY(-1px);
  }

  .stack-pill:hover,
  .stack-pill:focus-visible {
    color: var(--neon2);
    border-color: color-mix(in srgb, var(--neon) 45%, transparent);
    box-shadow: 0 0 calc(12px * var(--glow)) color-mix(in srgb, var(--neon) 40%, transparent);
    outline: none;
  }

  .stack-pill-icon {
    display: inline-block;
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
  }

  .stack-pill-text {
    text-transform: uppercase;
  }

  .stack-fade {
    position: absolute;
    top: 0;
    width: 10%;
    height: 100%;
    z-index: 10;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .stack-fade-left {
    left: 0;
    mask-image: linear-gradient(to right, #000 0%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, #000 0%, transparent 100%);
  }
  .stack-fade-right {
    right: 0;
    mask-image: linear-gradient(to left, #000 0%, transparent 100%);
    -webkit-mask-image: linear-gradient(to left, #000 0%, transparent 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .stack-marquee [class*='animate-[scroll'] {
      animation: none !important;
    }
  }
</style>
