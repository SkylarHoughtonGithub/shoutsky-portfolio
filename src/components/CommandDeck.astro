---
export interface TerminalLine {
  prompt?: string
  text: string
  kind?: 'cmd' | 'out'
}

export interface RadarBlip {
  slug: string
  name: string
  description?: string
  status?: 'shipped' | 'in-progress' | 'paused' | 'archived'
}

const STATUS_LABEL: Record<string, string> = {
  shipped: 'Shipped',
  'in-progress': 'In progress',
  paused: 'Paused',
  archived: 'Archived',
}

export interface Props {
  lines?: TerminalLine[]
  title?: string
  blips?: RadarBlip[]
}

const defaultLines: TerminalLine[] = [
  { prompt: '$', text: 'whoami', kind: 'cmd' },
  { text: 'skylar.houghton', kind: 'out' },
  { prompt: '$', text: 'cat ./role.txt', kind: 'cmd' },
  { text: 'backend & infrastructure engineer', kind: 'out' },
  { prompt: '$', text: 'ls ~/stack', kind: 'cmd' },
  { text: 'python/  go/  typescript/  docker/  kubernetes/  terraform/  ansible/', kind: 'out' },
  { prompt: '$', text: 'cat ./status.txt', kind: 'cmd' },
  { text: 'open to backend / platform / SRE roles', kind: 'out' },
]

const { lines = defaultLines, title = 'command deck', blips = [] } = Astro.props

const SWEEP_SECONDS = 4
const positionedBlips = blips.map((blip, i) => {
  const count = Math.max(blips.length, 1)
  const sweepAngle = (360 / count) * i
  const angle = sweepAngle - 90
  const distance = 0.55 + (i % 2) * 0.22
  const rad = (angle * Math.PI) / 180
  return {
    ...blip,
    x: 50 + Math.cos(rad) * distance * 42,
    y: 50 + Math.sin(rad) * distance * 42,
    pingDelay: (sweepAngle / 360) * SWEEP_SECONDS,
    tooltipAbove: sweepAngle > 90 && sweepAngle < 270,
  }
})
---

<section class="command-deck" aria-label="Command deck">
  <header class="deck-header">
    <div class="deck-dots" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <span class="deck-title">{title}</span>
    <span class="deck-status" aria-live="polite">
      <span class="deck-status-pulse" aria-hidden="true"></span>
      online
    </span>
  </header>

  <div class="deck-bays">
    <div class="bay bay-terminal" data-bay="terminal">
      <ol class="term-lines">
        {lines.map((line) => (
          <li class:list={['term-line', line.kind === 'out' ? 'is-out' : 'is-cmd']}>
            {line.prompt && <span class="term-prompt">{line.prompt}</span>}
            <span class="term-text">{line.text}</span>
          </li>
        ))}
      </ol>
      <span class="term-cursor" aria-hidden="true"></span>
    </div>

    <div class="bay bay-radar" data-bay="radar">
      <div class="radar" role={positionedBlips.length ? 'list' : 'presentation'} aria-label="Featured projects">
        <div class="radar-grid" aria-hidden="true"></div>
        <div class="radar-sweep" aria-hidden="true"></div>
        {positionedBlips.length === 0 ? (
          <span class="radar-placeholder">no featured projects</span>
        ) : (
          <div class="radar-blips">
            {positionedBlips.map((blip) => (
              <a
                href={`/projects/${blip.slug}`}
                class:list={['radar-blip', `is-${blip.status ?? 'shipped'}`, blip.tooltipAbove && 'tooltip-above']}
                style={`--x:${blip.x}%;--y:${blip.y}%;--ping-delay:${blip.pingDelay}s`}
                role="listitem"
              >
                <span class="radar-blip-dot" aria-hidden="true"></span>
                <span class="radar-blip-card">
                  <span class="radar-blip-name">{blip.name}</span>
                  {blip.description && <span class="radar-blip-desc">{blip.description}</span>}
                  {blip.status && (
                    <span class:list={['radar-blip-status', `is-${blip.status}`]}>
                      <span class="radar-blip-status-dot" aria-hidden="true"></span>
                      {STATUS_LABEL[blip.status]}
                    </span>
                  )}
                </span>
              </a>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>

  <footer class="deck-controls">
    <button type="button" class="deck-btn" data-ctl="stars" disabled title="Toggle stars (phase 6)" aria-label="Toggle stars (phase 6)">
      <span class="icon-[tabler--sparkles] deck-btn-icon"></span><span>stars</span>
    </button>
    <button type="button" class="deck-btn" data-ctl="spin" disabled title="Toggle spin (phase 6)" aria-label="Toggle spin (phase 6)">
      <span class="icon-[tabler--rotate] deck-btn-icon"></span><span>spin</span>
    </button>
    <button type="button" class="deck-btn" data-ctl="cursor" disabled title="Toggle cursor follow (phase 6)" aria-label="Toggle cursor follow (phase 6)">
      <span class="icon-[tabler--pointer] deck-btn-icon"></span><span>cursor</span>
    </button>
    <button type="button" class="deck-btn" data-ctl="glow" aria-pressed="false" aria-label="Toggle glow intensity">
      <span class="icon-[tabler--bolt] deck-btn-icon"></span><span>glow</span>
    </button>
    <button type="button" class="deck-btn" data-ctl="theme" aria-label="Toggle theme">
      <span class="icon-[tabler--sun-moon] deck-btn-icon"></span><span>theme</span>
    </button>
  </footer>
</section>

<script>
  const deck = document.querySelector<HTMLElement>('.command-deck')
  if (deck) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    const lines = deck.querySelectorAll<HTMLLIElement>('.term-line')

    if (reduced) {
      lines.forEach((line) => line.classList.add('is-revealed'))
    } else {
      let delay = 250
      lines.forEach((line) => {
        setTimeout(() => line.classList.add('is-revealed'), delay)
        delay += 420
      })
    }

    const root = document.documentElement
    const glowBtn = deck.querySelector<HTMLButtonElement>('[data-ctl="glow"]')
    glowBtn?.addEventListener('click', () => {
      const isDark = root.classList.contains('dark')
      const normal = isDark ? '1' : '0.35'
      const subtle = isDark ? '0.35' : '0.1'
      const current = getComputedStyle(root).getPropertyValue('--glow').trim()
      const next = current === normal ? subtle : normal
      root.style.setProperty('--glow', next)
      glowBtn.setAttribute('aria-pressed', next === subtle ? 'true' : 'false')
    })

    const themeBtn = deck.querySelector<HTMLButtonElement>('[data-ctl="theme"]')
    themeBtn?.addEventListener('click', () => {
      const isDark = root.classList.contains('dark')
      window.__theme?.setTheme(isDark ? 'light' : 'dark')
    })
  }
</script>

<style>
  .command-deck {
    position: relative;
    border: 1px solid var(--term-border);
    border-radius: 0.5rem;
    background: var(--term-bg);
    color: var(--text);
    font-family: var(--font-mono);
    box-shadow:
      0 0 calc(32px * var(--glow)) color-mix(in srgb, var(--neon) 22%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--neon) 8%, transparent);
    overflow: hidden;
  }

  .deck-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 0.875rem;
    background: var(--term-header);
    border-bottom: 1px solid var(--term-border);
    font-size: 0.72rem;
    color: var(--term-muted);
  }

  .deck-dots { display: flex; gap: 0.375rem; }
  .deck-dots > span {
    width: 0.6rem; height: 0.6rem; border-radius: 999px; background: #3a4a40;
  }

  .deck-title {
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .deck-status {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--term-ok);
    text-shadow: 0 0 calc(10px * var(--glow)) color-mix(in srgb, var(--term-ok) 60%, transparent);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .deck-status-pulse {
    width: 0.45rem; height: 0.45rem; border-radius: 999px;
    background: var(--term-ok);
    box-shadow: 0 0 calc(8px * var(--glow)) color-mix(in srgb, var(--term-ok) 80%, transparent);
    animation: deck-pulse 2.4s ease-in-out infinite;
  }

  @keyframes deck-pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .deck-bays {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 1px;
    background: var(--term-border);
  }

  @media (max-width: 640px) {
    .deck-bays { grid-template-columns: 1fr; }
  }

  .bay {
    background: var(--term-bg);
    padding: 1rem 1.125rem 1.25rem;
    min-height: 15rem;
  }

  .bay-terminal {
    position: relative;
  }

  .term-lines {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.75;
    color: var(--term-text);
  }

  .term-line {
    display: flex;
    gap: 0.6rem;
    opacity: 0;
    transform: translateY(-2px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .term-line.is-revealed {
    opacity: 1;
    transform: translateY(0);
  }

  .term-prompt {
    color: var(--neon);
    text-shadow: 0 0 calc(8px * var(--glow)) color-mix(in srgb, var(--neon) 60%, transparent);
    user-select: none;
  }

  .term-line.is-cmd .term-text { color: var(--term-cmd); }
  .term-line.is-out .term-text {
    color: var(--term-text);
    padding-left: 1rem;
  }

  .term-cursor {
    display: inline-block;
    width: 0.5rem;
    height: 0.95rem;
    margin-left: 1rem;
    margin-top: 0.2rem;
    background: var(--term-cmd);
    box-shadow: 0 0 calc(10px * var(--glow)) color-mix(in srgb, var(--term-cmd) 70%, transparent);
    animation: deck-cursor-blink 1.1s steps(2, end) infinite;
    vertical-align: middle;
  }

  @keyframes deck-cursor-blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  .bay-radar {
    display: grid;
    place-items: center;
    padding: 1.25rem;
    border-left: 1px solid var(--term-border);
  }

  @media (max-width: 640px) {
    .bay-radar { border-left: none; border-top: 1px solid var(--term-border); }
  }

  .radar {
    position: relative;
    width: 100%;
    max-width: 14rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--neon) 10%, transparent) 0%, transparent 68%);
  }

  .radar-grid {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--term-muted) 30%, transparent);
    background:
      radial-gradient(circle, transparent 24.5%, color-mix(in srgb, var(--term-muted) 22%, transparent) 25%, transparent 25.5%),
      radial-gradient(circle, transparent 49.5%, color-mix(in srgb, var(--term-muted) 22%, transparent) 50%, transparent 50.5%),
      radial-gradient(circle, transparent 74.5%, color-mix(in srgb, var(--term-muted) 22%, transparent) 75%, transparent 75.5%),
      linear-gradient(to right, transparent calc(50% - 0.5px), color-mix(in srgb, var(--term-muted) 18%, transparent) 50%, transparent calc(50% + 0.5px)),
      linear-gradient(to bottom, transparent calc(50% - 0.5px), color-mix(in srgb, var(--term-muted) 18%, transparent) 50%, transparent calc(50% + 0.5px));
  }

  .radar-sweep {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      color-mix(in srgb, var(--neon) 55%, transparent) 0deg,
      color-mix(in srgb, var(--neon) 15%, transparent) 25deg,
      transparent 60deg,
      transparent 360deg
    );
    animation: radar-sweep 4s linear infinite;
    mix-blend-mode: screen;
    pointer-events: none;
  }

  @keyframes radar-sweep {
    from { transform: rotate(0deg); }
    to   { transform: rotate(360deg); }
  }

  .radar-blips {
    position: absolute;
    inset: 0;
  }

  .radar-blip {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate(-50%, -50%);
    display: block;
    width: 1.4rem;
    height: 1.4rem;
    text-decoration: none;
    color: var(--term-text);
  }

  .radar-blip:focus-visible {
    outline: 2px solid var(--neon);
    outline-offset: 3px;
    border-radius: 50%;
  }

  .radar-blip-dot {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--neon);
    box-shadow: 0 0 calc(10px * var(--glow)) color-mix(in srgb, var(--neon) 80%, transparent);
    opacity: 0.45;
    animation: radar-blip-ping 4s linear infinite;
    animation-delay: var(--ping-delay, 0s);
    transition: transform 0.2s ease;
  }

  @keyframes radar-blip-ping {
    0%   { opacity: 0.9; transform: scale(1.25); }
    15%  { opacity: 0.75; transform: scale(1.1); }
    40%  { opacity: 0.5; transform: scale(1); }
    100% { opacity: 0.45; transform: scale(1); }
  }

  .radar-blip.is-shipped .radar-blip-dot {
    background: var(--term-ok);
    box-shadow: 0 0 calc(10px * var(--glow)) color-mix(in srgb, var(--term-ok) 80%, transparent);
  }

  .radar-blip.is-paused .radar-blip-dot,
  .radar-blip.is-archived .radar-blip-dot {
    background: var(--term-muted);
    box-shadow: none;
  }

  .radar-blip:hover .radar-blip-dot,
  .radar-blip:focus-visible .radar-blip-dot {
    animation: none;
    opacity: 1;
    transform: scale(1.5);
  }

  .radar-blip-card {
    position: absolute;
    left: 50%;
    top: calc(100% + 0.5rem);
    transform: translateX(-50%);
    width: max-content;
    max-width: 15rem;
    padding: 0.5rem 0.65rem;
    background: var(--term-header);
    color: var(--term-text);
    border: 1px solid var(--term-border);
    border-radius: 0.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    text-align: left;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.18s ease;
    z-index: 3;
    box-shadow: 0 0 calc(16px * var(--glow)) color-mix(in srgb, var(--neon) 22%, transparent);
  }

  .radar-blip.tooltip-above .radar-blip-card {
    top: auto;
    bottom: calc(100% + 0.5rem);
  }

  .radar-blip:hover .radar-blip-card,
  .radar-blip:focus-visible .radar-blip-card { opacity: 1; }

  .radar-blip-name {
    color: var(--term-cmd);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .radar-blip-desc {
    color: var(--term-text);
    font-size: 0.7rem;
    line-height: 1.45;
    font-family: var(--font-sans);
    opacity: 0.85;
  }

  .radar-blip-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--term-muted);
    font-size: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .radar-blip-status-dot {
    width: 0.35rem; height: 0.35rem; border-radius: 999px; background: var(--term-muted);
  }
  .radar-blip-status.is-shipped .radar-blip-status-dot { background: var(--term-ok); }
  .radar-blip-status.is-in-progress .radar-blip-status-dot { background: var(--neon); }

  .radar-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--term-muted);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .deck-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.625rem 0.875rem;
    background: var(--term-header);
    border-top: 1px solid var(--term-border);
  }

  .deck-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--term-border);
    border-radius: 0.3rem;
    background: var(--term-bg);
    color: var(--term-muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    cursor: pointer;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      background 0.2s ease;
  }

  .deck-btn:hover:not(:disabled),
  .deck-btn:focus-visible:not(:disabled) {
    color: var(--neon2);
    border-color: color-mix(in srgb, var(--neon) 45%, transparent);
    box-shadow: 0 0 calc(10px * var(--glow)) color-mix(in srgb, var(--neon) 40%, transparent);
    outline: none;
  }

  .deck-btn[aria-pressed='true'] {
    color: var(--term-cmd);
    border-color: color-mix(in srgb, var(--neon) 55%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--neon) 35%, transparent);
  }

  .deck-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .deck-btn-icon {
    width: 0.9rem;
    height: 0.9rem;
    display: inline-block;
  }

  @media (prefers-reduced-motion: reduce) {
    .term-line { transition: none; }
    .term-cursor,
    .deck-status-pulse,
    .radar-sweep,
    .radar-blip-dot { animation: none; }
    .radar-sweep { opacity: 0.25; }
    .radar-blip-dot { opacity: 0.75; }
  }
</style>
