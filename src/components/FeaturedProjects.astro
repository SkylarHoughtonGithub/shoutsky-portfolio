---
import { getAllProjects } from '~/lib/data'

const projects = (await getAllProjects()).filter((p) => p.data.featured).slice(0, 3)

const statusLabel: Record<string, string> = {
  shipped: 'Shipped',
  'in-progress': 'In progress',
  paused: 'Paused',
  archived: 'Archived',
}
---

<div class="grid grid-cols-1 md:grid-cols-3 gap-3">
  {projects.map((p) => (
    <a href={`/projects/${p.id}`} class="project-card featured-card block p-4">
      <div class="flex items-start justify-between gap-2 mb-2">
        <h3 class="font-semibold text-lg tracking-tight">{p.data.name}</h3>
        {p.data.status && (
          <span class="shrink-0 inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md border border-tag-border bg-tag-bg text-tag-text text-[10px] font-medium uppercase tracking-wide">
            {p.data.status === 'shipped' && <span class="size-1.5 rounded-full bg-[var(--term-ok)]" />}
            {p.data.status === 'in-progress' && <span class="size-1.5 rounded-full bg-[var(--neon)] animate-pulse" />}
            {p.data.status === 'paused' && <span class="size-1.5 rounded-full bg-[var(--muted)]" />}
            {statusLabel[p.data.status]}
          </span>
        )}
      </div>
      <p class="text-sm text-muted-foreground mb-3 line-clamp-3">{p.data.description}</p>
      {p.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-1">
          {p.data.tags.slice(0, 4).map((tag) => (
            <span class="inline-flex items-center px-1.5 py-0.5 rounded border border-tag-border bg-tag-bg text-tag-text text-[9px] uppercase tracking-wide">
              {tag}
            </span>
          ))}
        </div>
      )}
    </a>
  ))}
</div>
